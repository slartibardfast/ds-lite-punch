# ds-lite-punch runtime config. One instance = one CGNAT mapping.
# bind:    relay socket on the hub-LAN address (the CGNAT-facing tuple).
# target:  br-lan endpoint inbound datagrams are forwarded to (source preserved).
# stun:    comma-separated host:port list (rotated on silence).
# gateway: hub next-hop used to force STUN out the VM line (host routes).
# upnp:    the IGD facade (plan/0007 phase E) listens on br-lan; LAN_IP is
#          the br-lan address (SSDP group join + HTTP service bind br-lan).
BIND=192.168.0.21:40000
TARGET=192.168.21.1:40001
STUN=stun.l.google.com:19302,stun.cloudflare.com:3478
INTERVAL=2
GATEWAY=192.168.0.1
UPNP_PORT=49152
LAN_IP=192.168.21.1
# upnp:  1 = IGD facade on (default); 0 = off (a real IGD already on the
#        LAN, or any other occupant of UDP 1900, must not take the
#        keepalive daemon down with the facade).
UPNP=1

# DeviceProtection bootstrap (call/0023): a root-owned ACL/user store that the
# init script copies into the state directory when no store exists yet, so the
# operator has a way to create the first identity. Format is one tab-separated
# row per entry, the same as the daemon's dp.tsv:
#   U<TAB>name<TAB>salt-hex32<TAB>stored-hex32<TAB>roles   (a PKCS5 user)
#   A<TAB>name<TAB>alias-or-dash<TAB>id-hex32<TAB>roles     (an ACL identity)
# stored is the first 128 bits of PBKDF2-HMAC-SHA-256(password, name||salt,
# 5000 iterations); the roles are Public/Basic/Admin, Admin satisfying Basic.
# Leave it unset (or "none") to disable the seed and keep the store empty.
# DEVICE_PROTECTION_ACL=/etc/ds-lite-punch.acl

# The hold (call/0025, plan/0009). ALLOWLIST names the file holding one IPv4
# address per line ('#' comments allowed); those devices' flows get the RFC
# conntrack lifetimes locally and are kept alive by the daemon's own writes.
# The list is a budget, not a convenience: one held flow costs about half a
# packet a second at the two-second cadence. HOLD=0 leaves the arm in its
# log-only stage (it reports the named devices' live flows and touches
# nothing), which is where a new device is admitted from. OBSERVATION=1
# enables the arm itself.
# ALLOWLIST=/etc/ds-lite-punch.allow
# HOLD=0
# OBSERVATION=1

# The shared port (call/0025's fourth admission, plan/0009 #pcp): PCP (RFC
# 6887) and NAT-PMP (RFC 6886) on UDP 5351, LAN-only, riding the same slot
# engine as the UPnP facade. PCP_PEER=1 answers the PEER opcode with the
# mapping's own tuple; the datapath is endpoint-independent, so that opcode
# installs nothing and is otherwise refused.
# PCP=0
# PCP_PEER=0
