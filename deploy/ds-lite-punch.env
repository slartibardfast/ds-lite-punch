# ds-lite-punch runtime config. One instance = one CGNAT mapping.
# bind:    relay socket on the hub-LAN address (the CGNAT-facing tuple).
# target:  br-lan endpoint inbound datagrams are forwarded to (source preserved).
# stun:    comma-separated host:port list (rotated on silence).
# gateway: hub next-hop used to force STUN out the VM line (host routes).
BIND=192.168.0.21:40000
TARGET=192.168.21.1:40001
STUN=stun.l.google.com:19302,stun.cloudflare.com:3478
INTERVAL=2
GATEWAY=192.168.0.1
