[Unit]
Description=front door nginx (its own root, its own configuration)
After=network-online.target

[Service]
Type=forking
PIDFile=<FRONT_ROOT>/logs/front.pid
ExecStartPre=/usr/sbin/nginx -c <FRONT_ROOT>/nginx.conf -t
ExecStart=/usr/sbin/nginx -c <FRONT_ROOT>/nginx.conf
ExecReload=/usr/sbin/nginx -c <FRONT_ROOT>/nginx.conf -s reload
ExecStop=/usr/sbin/nginx -c <FRONT_ROOT>/nginx.conf -s quit
Restart=on-failure

[Install]
WantedBy=multi-user.target