[Unit]
Description=front door nginx (its own root, its own configuration)
After=network-online.target

[Service]
Type=forking
PIDFile=<FRONT_ROOT>/logs/front.pid
ExecStartPre=<NGINX_BIN> -c <FRONT_ROOT>/nginx.conf -t
ExecStart=<NGINX_BIN> -c <FRONT_ROOT>/nginx.conf
ExecReload=<NGINX_BIN> -c <FRONT_ROOT>/nginx.conf -s reload
ExecStop=<NGINX_BIN> -c <FRONT_ROOT>/nginx.conf -s quit
Restart=on-failure

[Install]
WantedBy=multi-user.target