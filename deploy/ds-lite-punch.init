#!/bin/sh /etc/rc.common
# ds-lite-punch: the CGNAT-aware UDP relay, run by procd, configured in /etc/ds-lite-punch.env.
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/ds-lite-punch
CONF=/etc/ds-lite-punch.env
# Seed the DeviceProtection store from /etc/ds-lite-punch.acl at start, when no store exists; without it every gated action answers 606.
ACL_DEFAULT=/etc/ds-lite-punch.acl
STATE=/run/ds-lite-punch

# Remove the daemon's datapath: its own table, and the per-slot accepts it inserted in the firewall's tables.
cleanup_nft() {
    nft delete table ip dslp 2>/dev/null
    for h in $(nft -a list chain inet fw4 input 2>/dev/null \
        | grep -E 'comment "(dslitepunch(-[0-9]+)?)"' \
        | grep -oE 'handle [0-9]+' | awk '{print $2}'); do
        nft delete rule inet fw4 input handle "$h" 2>/dev/null
    done
}

# Remove the daemon's tuple-egress policy (table 1001 / prio 25100).
cleanup_egress() {
    ip rule del prio 25100 2>/dev/null
    ip route flush table 1001 2>/dev/null
}

stop_service() {
    cleanup_nft
    cleanup_egress
}

start_service() {
    [ -x "$PROG" ] || { echo "ds-lite-punch: $PROG missing"; return 1; }
    [ -f "$CONF" ] || { echo "ds-lite-punch: $CONF missing"; return 1; }
    . "$CONF"

    ACL="${DEVICE_PROTECTION_ACL:-$ACL_DEFAULT}"
    if [ "$ACL" != "none" ] && [ -f "$ACL" ] && [ ! -f "$STATE/dp.tsv" ]; then
        mkdir -p "$STATE"
        if cp "$ACL" "$STATE/dp.tsv"; then
            logger -t ds-lite-punch "seeded DeviceProtection store from $ACL"
        fi
    fi

    # A legacy single-map input accept, kept while the single-map form is supported.
    if ! nft list chain inet fw4 input 2>/dev/null | grep -q dslitepunch; then
        nft insert rule inet fw4 input iifname "eth1" udp dport "${BIND##*:}" accept comment dslitepunch
    fi

    # An opkg upgrade replaces this script, so the settings belong in the env file.
    NO_UPNP=
    [ "${UPNP:-1}" = "1" ] || NO_UPNP=--no-upnp

    # The keepalive: the allowlist names the devices, and KEEPALIVE=1 turns the arm from reporting their flows to keeping their mappings alive.
    ALLOW=
    if [ -n "$ALLOWLIST" ] && [ -f "$ALLOWLIST" ]; then
        ALLOW="--allowlist $ALLOWLIST"
        [ "${KEEPALIVE:-0}" = "1" ] && ALLOW="$ALLOW --keepalive"
    fi

    # The shared port: PCP and NAT-PMP on UDP 5351, off by default because nothing on a LAN asks for PCP.
    PCPF=
    [ "${PCP:-0}" = "1" ] && PCPF="--pcp"
    [ "${PCP_PEER:-0}" = "1" ] && PCPF="$PCPF --pcp-peer"

    # The carrier watch: the counter that records the helper's marked probe, and the alarm when it stops rising.
    WATCHF=
    [ "${CARRIER_PROBE:-0}" = "1" ] && WATCHF="--carrier-probe"
    [ -n "$CARRIER_PROBE_INTERVAL" ] &&
        WATCHF="$WATCHF --carrier-probe-interval $CARRIER_PROBE_INTERVAL"
    [ -n "$CARRIER_PROBE_MISSES" ] &&
        WATCHF="$WATCHF --carrier-probe-misses $CARRIER_PROBE_MISSES"
    [ -n "$CARRIER_PROBE_POLL" ] &&
        WATCHF="$WATCHF --carrier-probe-poll $CARRIER_PROBE_POLL"
    procd_open_instance
    procd_set_param command "$PROG" \
        --bind "$BIND" --target "$TARGET" --stun "$STUN" \
        --interval "$INTERVAL" --gateway "$GATEWAY" \
        --slot-port-range "${SLOT_RANGE:-30000-39999}" \
        --max-slots "${MAX_SLOTS:-32}" \
        --max-maps-per-client "${MAX_MAPS_PER_CLIENT:-16}" \
        --upnp-port "${UPNP_PORT:-49152}" \
        --lan-ip "${LAN_IP:-192.168.21.1}" \
        $NO_UPNP \
        $ALLOW $PCPF $WATCHF \
        ${OBSERVATION:+--observation}
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
