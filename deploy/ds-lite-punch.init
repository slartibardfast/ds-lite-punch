#!/bin/sh /etc/rc.common
# ds-lite-punch — CGNAT-aware UDP relay for the Virgin Media ds-lite line.
# ImmortalWrt uses procd (not systemd); config lives in /etc/ds-lite-punch.env.
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/ds-lite-punch
CONF=/etc/ds-lite-punch.env
# The DeviceProtection bootstrap (call/0023). The ACL and user store lives in
# the state directory, which is tmpfs and therefore lost on reboot, and the
# daemon has no in-band way to create its first identity (the introduction
# protocol is deferred, call/0021). So a root-owned file here seeds it: on
# start, if no store exists yet, the file is copied in as dp.tsv. Absent the
# file the store stays empty and every role-gated action answers 606, which is
# the fail-closed default. Set DEVICE_PROTECTION_ACL= to something else in the
# env file to move it, or to "none" to disable the seed.
ACL_DEFAULT=/etc/ds-lite-punch.acl
STATE=/run/ds-lite-punch

# Remove the ds-lite-punch nft datapath: the named-map ruleset table plus
# any per-slot input-accepts (comments dslitepunch / dslitepunch-<R>).
# Idempotent; keeps the router state clean after stop (merge-gate item).
cleanup_nft() {
    nft delete table ip dslp 2>/dev/null
    for h in $(nft -a list chain inet fw4 input 2>/dev/null \
        | grep -E 'comment "(dslitepunch(-[0-9]+)?)"' \
        | grep -oE 'handle [0-9]+' | awk '{print $2}'); do
        nft delete rule inet fw4 input handle "$h" 2>/dev/null
    done
}

# Remove the daemon's tuple-egress policy (table 1001 / prio 25100).
cleanup_egress() {
    ip rule del prio 25100 2>/dev/null
    ip route flush table 1001 2>/dev/null
}

stop_service() {
    cleanup_nft
    cleanup_egress
}

start_service() {
    [ -x "$PROG" ] || { echo "ds-lite-punch: $PROG missing"; return 1; }
    [ -f "$CONF" ] || { echo "ds-lite-punch: $CONF missing"; return 1; }
    . "$CONF"

    ACL="${DEVICE_PROTECTION_ACL:-$ACL_DEFAULT}"
    if [ "$ACL" != "none" ] && [ -f "$ACL" ] && [ ! -f "$STATE/dp.tsv" ]; then
        mkdir -p "$STATE"
        if cp "$ACL" "$STATE/dp.tsv"; then
            logger -t ds-lite-punch "seeded DeviceProtection store from $ACL"
        fi
    fi

    # Legacy single-map input-accept (P1 path). The daemon installs its own
    # per-slot accepts (comment dslitepunch-<R>) at startup (B4); this rule
    # is kept while P1 flag semantics are supported.
    if ! nft list chain inet fw4 input 2>/dev/null | grep -q dslitepunch; then
        nft insert rule inet fw4 input iifname "eth1" udp dport "${BIND##*:}" accept comment dslitepunch
    fi

    # The facade is default-on; an operator with a real IGD on the LAN (or
    # a dead UDP 1900) can disable it via UPNP=0 in the env file — the rc
    # surface must expose the flag, or every fix would be overwritten by
    # an opkg upgrade.
    NO_UPNP=
    [ "${UPNP:-1}" = "1" ] || NO_UPNP=--no-upnp
    procd_open_instance
    procd_set_param command "$PROG" \
        --bind "$BIND" --target "$TARGET" --stun "$STUN" \
        --interval "$INTERVAL" --gateway "$GATEWAY" \
        --slot-port-range "${SLOT_RANGE:-30000-39999}" \
        --max-slots "${MAX_SLOTS:-32}" \
        --max-maps-per-client "${MAX_MAPS_PER_CLIENT:-16}" \
        --upnp-port "${UPNP_PORT:-49152}" \
        --lan-ip "${LAN_IP:-192.168.21.1}" \
        $NO_UPNP \
        ${OBSERVATION:+--observation}
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
